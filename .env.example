# ── Obvezno ──────────────────────────────────
OPENAI_API_KEY=sk-...                   # prepis, spletno iskanje, izbira trditev
ANTHROPIC_API_KEY=sk-ant-...            # koraki analize in razsodba nad gradivom

# ── Neobvezno — brez ključa zbiralec preprosto ne steče ───
# PERPLEXITY_API_KEY=pplx-...           # iskanje z obveznim navajanjem virov
# XAI_API_KEY=xai-...                   # Grok, iskanje po spletu in omrežju X
# GOOGLE_FACTCHECK_API_KEY=AIza...      # objavljena preverjanja dejstev
# OPENALEX_EMAIL=ti@primer.si           # vljudnostna vrstica za OpenAlex in Crossref

# ── Strežnik ─────────────────────────────────
# ADMIN_SECRET=your-secret-here         # skrbniške poti za upravljanje kreditov
# CORS_ORIGINS=http://localhost:5173    # dovoljeni izvori odjemalca
